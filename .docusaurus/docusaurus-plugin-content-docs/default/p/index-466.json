","description":"1.前言"},"待完善/pro-linux":{"id":"待完善/pro-linux","title":"Linux","description":"前言"},"待完善/pro-windows":{"id":"待完善/pro-windows","title":"Windows","description":"安装 JDK"},"ad/ad":{"id":"ad/ad","title":"服务器推荐 ✨","description":"通过以下链接注册新用户后，可以免费帮忙部署","sidebar":"docsSidebar"},"advanced/1":{"id":"advanced/1","title":"公共图标设置","description":"AIkanPro 拥有公共图标完全由AikanPro用户提供，这里免费给AikanPro正式版用户免费使用"},"advanced/adve":{"id":"advanced/adve","title":"激励广告","description":"UniAD广告回调","sidebar":"docsSidebar"},"advanced/api":{"id":"advanced/api","title":"API 命令表","description":"AIkanPro 拥有两套命令表，大家可以根据自己实际情况来用，第二种比较方便简单","sidebar":"docsSidebar"},"advanced/icon":{"id":"advanced/icon","title":"**图标转跳配置教程**","description":"常用链接","sidebar":"docsSidebar"},"advanced/img_public":{"id":"advanced/img_public","title":"公共图标设置","description":"AIkanPro 拥有公共图标完全由AikanPro用户提供，这里免费给AikanPro正式版用户免费使用","sidebar":"docsSidebar"},"advanced/push":{"id":"advanced/push","title":"消息推送配置","description":"配置unipush消息通知","sidebar":"docsSidebar"},"changelog/os":{"id":"changelog/os","title":"开源社区版更新日志","description":"0.0.0","sidebar":"docsSidebar"},"changelog/pro":{"id":"changelog/pro","title":"Pro版更新日志","description":"购买Pro版可以上 查看功能介绍并购买.","sidebar":"docsSidebar"},"config/config-db":{"id":"config/config-db","title":"数据库配置","description":"爱看Pro 默认使用 MySQL 数据库可通过配置文件修改。","sidebar":"docsSidebar"},"config/config-debug":{"id":"config/config-debug","title":"抢救模式","description":"如您不甚忘记所有管理员密码后，可修改数据库文件开启 抢救 模式，修改后可在复制md5加密的密码进行破译查看，推荐查看md5网站，请自行百度.","sidebar":"docsSidebar"},"config/config-port":{"id":"config/config-port","title":"启动端口","description":"爱看Pro 默认端口为 8080，如果你的服务器已经占用了 8080 端口，可以修改端口号。","sidebar":"docsSidebar"},"custom-js/baidu-tongji":{"id":"custom-js/baidu-tongji","title":"百度统计代码如何添加到 AikanPro","description":"登录 百度统计 后点击上方的 \"使用设置\"，在网站列表右侧点击 \"获取代码\"，然后复制代码添加到 AikanPro 的 \"自定义 JS\" 中即可。","sidebar":"docsSidebar"},"example/cos":{"id":"example/cos","title":"腾讯云 COS","description":"注意：如果你使用了自定义域名，且在腾讯云开启了回源鉴权，那么需要在 AikanPro 中要使用自定义域名，否则会导致无法正常使用。（回源鉴权表示无论是是否是私有空间，通过 cdn 域名下载文件都不需要增加任何签名，也可以理解为变成了公共下载，这时候带签名下载反而会报错。）","sidebar":"docsSidebar"},"example/ftp":{"id":"example/ftp","title":"FTP","description":"待补充","sidebar":"docsSidebar"},"example/obs":{"id":"example/obs","title":"华为云 OBS","description":"帮我安装🔍","sidebar":"docsSidebar"},"example/oss":{"id":"example/oss","title":"阿里云 OSS","description":"注意：目前使用该对象存储","sidebar":"docsSidebar"},"example/qiniu":{"id":"example/qiniu","title":"七牛云","description":"帮我安装🔍","sidebar":"docsSidebar"},"example/sftp":{"id":"example/sftp","title":"SFTP","description":"待补充","sidebar":"docsSidebar"},"feature/intr":{"id":"feature/intr","title":"实图介绍","description":"| 演示快照，点击即看效果 | 网站 点击即可               |","sidebar":"docsSidebar"},"feature/product":{"id":"feature/product","title":"实用功能","description":"| 演示快照，点击即看效果 | 网站 点击即可               |","sidebar":"docsSidebar"},"feature/text":{"id":"feature/text","title":"更新计划！","description":"| 演示快照，点击即看效果 | 网站 点击即可               |","sidebar":"docsSidebar"},"install/Free-AikanFree":{"id":"install/Free-AikanFree","title":"Linux","description":"等待开发!","sidebar":"docsSidebar"},"install/Free-AikanFreeApi":{"id":"install/Free-AikanFreeApi","title":"Linux","description":"等待开发!","sidebar":"docsSidebar"},"install/Free-AikanFreeApp":{"id":"install/Free-AikanFreeApp","title":"Linux","description":"等待开发!","sidebar":"docsSidebar"},"install/Pro-AikanPro":{"id":"install/Pro-AikanPro","title":"AikanPro","description":"在线视频安装教程","sidebar":"docsSidebar"},"install/Pro-AikanProAPI":{"id":"install/Pro-AikanProAPI","title":"AikanProAPI","description":"快速跳转：反向代理","sidebar":"docsSidebar"},"install/Pro-AikanProApp":{"id":"install/Pro-AikanProApp","title":"AikanProApp","description":"在线视频安装教程","sidebar":"docsSidebar"},"install/Pro-AikanProImg":{"id":"install/Pro-AikanProImg","title":"AikanProImg","description":"前言准备","sidebar":"docsSidebar"},"intro":{"id":"intro","title":"","description":"基于 StarPro 二开的程序，为社区/博客/自媒体/知识付费/论坛提供解决方案的一整套项目体系。它包括接口端，后台控制端，APP客户端，和响应式网页端。通过它，您可以快捷的构筑多功能，高性能，高安全性的个人互联网社区。","sidebar":"docsSidebar"},"question/bind-domain":{"id":"question/bind-domain","title":"如何用域名访问？","description":"参考：点我前往","sidebar":"docsSidebar"},"question/download-log":{"id":"question/download-log","title":"如何查看/下载日志？","description":"后台下载","sidebar":"docsSidebar"},"question/reset-password":{"id":"question/reset-password","title":"忘记管理员密码怎么办？","description":"启用 抢救模式 模式即可，参考：点我前往","sidebar":"docsSidebar"},"question/run-multiple-instance":{"id":"question/run-multiple-instance","title":"如何运行多个 AikanPro 实例","description":"请结合文档中这两个方法：","sidebar":"docsSidebar"},"question/sg15":{"id":"question/sg15","title":"SG15 加密组件安装","description":"宝塔面板 PHP7.2（我们目前使用的版本） 组件 SG15加密 暂末更新 请手动安装","sidebar":"docsSidebar"},"question/start-fail":{"id":"question/start-fail","title":"启动失败/无法访问怎么办？","description":"如启动后浏览器访问 http8080 无法访问，一般有以下几种原因：请检查 端口是否冲突 或 防火墙/安全组是否开启。","sidebar":"docsSidebar"},"question/upload-fail-baota":{"id":"question/upload-fail-baota","title":"上传失败怎么办？","description":"上传超过 50M 的文件失败","sidebar":"docsSidebar"},"support/support-pf":{"id":"support/support-pf","title":"技术支持","description":"- 官方文档内是有详细搭建教程的，一条龙服务只是提供给需要的人，该渠道是AikanPro官方服务渠道","sidebar":"docsSidebar"},"support/support-term":{"id":"support/support-term","title":"部署一条龙指南","description":"全程由我本机一条龙安装的好处：","sidebar":"docsSidebar"},"UserGS":{"id":"UserGS","title":"许可协议 / 免责声明","description":"请勿将本程序用于诈骗、色情、赌博、木马、病毒等违法行为，如有违反该条例，我们将配合公安机关追究法律责任！目前将响应相关法律政策，逐步加入API封禁机制，  违法违规站点将直接永久禁用API和后台，届时将无法使用，无法安装。","sidebar":"docsSidebar"}}}}